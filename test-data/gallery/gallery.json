    {"id": "exposure-minus", "command": "exposure -1", "control": "exposure", "expect": [{"metric": "mean_luma", "dir": "down"}]},
    {"id": "contrast-plus", "command": "contrast 100", "control": "contrast", "expect": [{"metric": "p95_luma", "dir": "up"}, {"metric": "p5_luma", "dir": "down"}]},
    {"id": "contrast-minus", "command": "contrast -100", "control": "contrast", "expect": [{"metric": "p95_luma", "dir": "down"}, {"metric": "p5_luma", "dir": "up"}]},
    {"id": "highlights-minus", "command": "highlights -100", "control": "highlights", "expect": [{"metric": "p95_luma", "dir": "down"}]},
    {"id": "highlights-plus", "command": "highlights 100", "control": "highlights", "expect": [{"metric": "p75_luma", "dir": "up"}]},
    {"id": "shadows-plus", "command": "shadows 100", "control": "shadows", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "shadows-minus", "command": "shadows -100", "control": "shadows", "expect": [{"metric": "mean_luma", "dir": "down"}]},
    {"id": "whites-plus", "command": "whites 100", "control": "whites", "expect": [{"metric": "p95_luma", "dir": "up"}]},
    {"id": "whites-minus", "command": "whites -100", "control": "whites", "expect": [{"metric": "p95_luma", "dir": "down"}]},
    {"id": "blacks-minus", "command": "blacks -100", "control": "blacks", "expect": [{"metric": "p5_luma", "dir": "down"}]},
    {"id": "blacks-plus", "command": "blacks 100", "control": "blacks", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "brightness-plus", "command": "brightness 100", "control": "brightness", "expect": [{"metric": "p50_luma", "dir": "up"}]},
    {"id": "brightness-minus", "command": "brightness -100", "control": "brightness", "expect": [{"metric": "p50_luma", "dir": "down"}]},
    {"id": "brilliance-plus", "command": "brilliance 100", "control": "brilliance", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "brilliance-minus", "command": "brilliance -100", "control": "brilliance", "expect": [{"metric": "mean_luma", "dir": "down"}]},
    {"id": "fade-max", "command": "fade 100", "control": "fade", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "saturation-plus", "command": "saturation 100", "control": "saturation", "expect": [{"metric": "mean_sat", "dir": "up"}]},
    {"id": "saturation-minus", "command": "saturation -100", "control": "saturation", "expect": [{"metric": "mean_sat", "dir": "down"}]}
  ]
}
