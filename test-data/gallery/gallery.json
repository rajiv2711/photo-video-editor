{
  "about": "Render test cases. The cloud build runs each command on the test photo (iPad simulator, -renderGallery) and dev-tools/ci_results.py checks the picture against the base case (or the case named in vs). Metrics: mean_luma, p5_luma, p25_luma, p50_luma, p75_luma, p95_luma, mean_sat, mean_r, mean_g, mean_b, diff, peak. Directions: up, down, changed, same.",
  "cases": [
    {"id": "base", "command": "", "expect": []},

    {"id": "exposure-plus", "command": "exposure 1", "control": "exposure", "expect": [{"metric": "mean_luma", "dir": "up"}]},
    {"id": "exposure-minus", "command": "exposure -1", "control": "exposure", "expect": [{"metric": "mean_luma", "dir": "down"}]},
    {"id": "contrast-plus", "command": "contrast 100", "control": "contrast", "expect": [{"metric": "p95_luma", "dir": "up"}, {"metric": "p5_luma", "dir": "down"}]},
    {"id": "contrast-minus", "command": "contrast -100", "control": "contrast", "expect": [{"metric": "p95_luma", "dir": "down"}, {"metric": "p5_luma", "dir": "up"}]},
    {"id": "highlights-minus", "command": "highlights -100", "control": "highlights", "expect": [{"metric": "p95_luma", "dir": "down"}]},
    {"id": "highlights-plus", "command": "highlights 100", "control": "highlights", "expect": [{"metric": "p75_luma", "dir": "up"}]},
    {"id": "shadows-plus", "command": "shadows 100", "control": "shadows", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "shadows-minus", "command": "shadows -100", "control": "shadows", "expect": [{"metric": "mean_luma", "dir": "down"}]},
    {"id": "whites-plus", "command": "whites 100", "control": "whites", "expect": [{"metric": "p95_luma", "dir": "up"}]},
    {"id": "whites-minus", "command": "whites -100", "control": "whites", "expect": [{"metric": "p95_luma", "dir": "down"}]},
    {"id": "blacks-minus", "command": "blacks -100", "control": "blacks", "expect": [{"metric": "p5_luma", "dir": "down"}]},
    {"id": "blacks-plus", "command": "blacks 100", "control": "blacks", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "brightness-plus", "command": "brightness 100", "control": "brightness", "expect": [{"metric": "p50_luma", "dir": "up"}]},
    {"id": "brightness-minus", "command": "brightness -100", "control": "brightness", "expect": [{"metric": "p50_luma", "dir": "down"}]},
    {"id": "brilliance-plus", "command": "brilliance 100", "control": "brilliance", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "brilliance-minus", "command": "brilliance -100", "control": "brilliance", "expect": [{"metric": "mean_luma", "dir": "down"}]},
    {"id": "fade-max", "command": "fade 100", "control": "fade", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "curve-highlights", "command": "curve highlights 100", "control": "curveHighlights", "expect": [{"metric": "p95_luma", "dir": "up"}]},
    {"id": "curve-lights", "command": "lights 100", "control": "curveLights", "expect": [{"metric": "p50_luma", "dir": "up"}]},
    {"id": "curve-darks", "command": "darks 100", "control": "curveDarks", "expect": [{"metric": "p25_luma", "dir": "up"}]},
    {"id": "curve-shadows", "command": "curve shadows -100", "control": "curveShadows", "expect": [{"metric": "p5_luma", "dir": "down"}]},
    {"id": "curve-point-mid", "command": "curve 50 70", "control": "curveRgb50", "expect": [{"metric": "p25_luma", "dir": "up"}]},
    {"id": "curve-point-black", "command": "curve 0 20", "control": "curveRgb0", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "curve-red", "command": "red curve 50 80", "control": "curveRed50", "expect": [{"metric": "mean_r", "dir": "up"}, {"metric": "mean_g", "dir": "same"}]},
    {"id": "curve-blue", "command": "blue curve 75 50", "control": "curveBlue75", "expect": [{"metric": "mean_b", "dir": "down"}]},
    {"id": "levels-input-black", "command": "input black 60", "control": "levelsInBlack", "expect": [{"metric": "p25_luma", "dir": "down"}]},
    {"id": "levels-input-white", "command": "input white 200", "control": "levelsInWhite", "expect": [{"metric": "p95_luma", "dir": "up"}]},
    {"id": "levels-gamma", "command": "gamma 2", "control": "levelsGamma", "expect": [{"metric": "p25_luma", "dir": "up"}]},
    {"id": "levels-output-black", "command": "output black 60", "control": "levelsOutBlack", "expect": [{"metric": "p5_luma", "dir": "up"}]},
    {"id": "levels-output-white", "command": "output white 180", "control": "levelsOutWhite", "expect": [{"metric": "p95_luma", "dir": "down"}]},
    {"id": "equalize-on", "command": "equalize on", "control": "equalize", "expect": [{"metric": "diff", "dir": "changed"}, {"metric": "p50_luma", "dir": "down"}]},
    {"id": "auto", "command": "auto", "control": "auto", "expect": [{"metric": "diff", "dir": "changed"}]},
    {"id": "saturation-plus", "command": "saturation 100", "control": "saturation", "expect": [{"metric": "mean_sat", "dir": "up"}]},
    {"id": "saturation-minus", "command": "saturation -100", "control": "saturation", "expect": [{"metric": "mean_sat", "dir": "down"}]}
  ]
}
